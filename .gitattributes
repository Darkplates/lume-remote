* text=auto
*.sh text eol=lf
*.command text eol=lf
gradlew text eol=lf
*.rs text eol=lf
*.java text eol=lf
*.swift text eol=lf
*.md text eol=lf
*.yml text eol=lf
# The Content-Security-Policy hash covers the exact LF bytes of the inline script.
docs/open.html text eol=lf
# Unified patches contain intentional context prefixes and upstream indentation.
native/peer/patches/*.patch text eol=lf -whitespace
# Upstream notices have byte-specific provenance hashes. Never normalize them.
third-party/** -text
*.png -text
*.ico -text
*.jar -text
